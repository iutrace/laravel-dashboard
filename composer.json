{
    "name": "iutrace/laravel-dashboard",
    "description": "Dashboard service",
    "type": "library",
    "keywords": [
        "iutrace",
        "laravel",
        "dashboard",
        "metrics",
        "graphs",
        "insights"
    ],
    "homepage": "https://github.com/iutrace/laravel-dashboard",
    "license": "MIT",
    "authors": [
        {
            "name": "Facundo Lezcano",
            "email": "flezcano@iupik.com"
        },
        {
            "name": "Lucas Correa",
            "email": "lcorrea@iupik.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0", 
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/validation": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.2",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Iutrace\\Dashboard\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Iutrace\\Dashboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Iutrace\\Dashboard\\DashboardServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
